NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Public site origin for SEO (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# Optional: Google Search Console "HTML tag" verification token (just the content value).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional, server-only (never prefix with NEXT_PUBLIC_). Enables invite emails for people
# without an account, and full Storage cleanup when an owner deletes a trip.
SUPABASE_SERVICE_ROLE_KEY=
